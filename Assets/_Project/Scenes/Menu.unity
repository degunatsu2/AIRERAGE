  - "\u53C2\u52A0\u30B3\u30FC\u30C9\u304BLAN\u3067\u3001\u6700\u59278\u4EBA\u3067\u5BFE\u6226\u3059\u308B\u3002"
  - "\u597D\u304D\u306A\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u3068\u30B9\u30C6\u30FC\u30B8\u3067\u7DF4\u7FD2\u3059\u308B\u3002"
  - "\u97F3\u91CF\u30FB\u753B\u9762\u30FB\u64CD\u4F5C\u30FB\u30A2\u30A4\u30C6\u30E0\u30FB\u8A00\u8A9E\u306E\u8A2D\u5B9A\u3002"
